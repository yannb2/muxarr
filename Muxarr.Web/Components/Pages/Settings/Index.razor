@page "/settings"
@page "/settings/{Tab}"
@page "/status"
@attribute [StreamRendering]
@inject NavigationManager Navigation

<PageTitle>@TitleHelper.GetTitle("Settings")</PageTitle>

<div class="container-fluid">
    <h2 class="border-bottom pb-2 mb-3"><i class="bi bi-gear me-2"></i>Settings</h2>

    @* One link per tab, as in Ripparr and the other sister apps, so a tab can be bookmarked or linked to. *@
    <ul class="nav nav-tabs mb-3">
        @foreach (var (key, label, icon) in Tabs)
        {
            <li class="nav-item">
                <a class="nav-link @(_tab == key ? "active" : "")" href="settings/@key">
                    <i class="bi @icon me-1"></i>@label
                </a>
            </li>
        }
    </ul>

    @switch (_tab)
    {
        case "integrations":
            <IntegrationsSettingsTab/>
            break;
        case "processing":
            <ProcessingSettingsTab/>
            break;
        case "notifications":
            <NotificationSettingsTab/>
            break;
        case "security":
            <AuthSettingsTab/>
            break;
        case "api":
            <ApiSettingsTab/>
            break;
        case "status":
            <StatusSettingsTab/>
            break;
        default:
            <ProfileSettingsTab/>
            break;
    }
</div>

@code {
    [Parameter] public string? Tab { get; set; }

    private string _tab = "profiles";

    /// <summary>The tabs, in order. A new kind of setting gets its own tab here.</summary>
    public static readonly (string Key, string Label, string Icon)[] Tabs =
    [
        ("profiles", "Profiles", "bi-sliders"),
        ("integrations", "Integrations", "bi-plug"),
        ("processing", "Processing", "bi-cpu"),
        ("notifications", "Notifications", "bi-bell"),
        ("security", "Security", "bi-shield-lock"),
        ("api", "API", "bi-code-slash"),
        ("status", "Status", "bi-info-circle")
    ];

    protected override void OnParametersSet()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
        var key = path == "status" ? "status" : Tab?.ToLowerInvariant();
        _tab = Tabs.Any(t => t.Key == key) ? key! : "profiles";
    }
}
