@page "/settings/profile/{Id:int}"
@page "/settings/profile/new"
@attribute [StreamRendering]

<PageTitle>@TitleHelper.GetTitle(_profile?.Name ?? "Profile")</PageTitle>

@if (_profile == null)
{
    <div class="container-fluid">
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Profile not found
        </div>
    </div>
    return;
}

<div class="container-fluid">
    <nav class="mb-2">
        <a href="/settings" class="text-muted small text-decoration-none">
            <i class="bi bi-arrow-left me-1"></i>Settings
        </a>
    </nav>
    <h2 class="border-bottom pb-3 mb-4">
        <i class="bi bi-sliders me-2"></i>@(IsNew ? "New Profile" : $"Edit Profile: {_profile.Name}")
    </h2>

    <EditForm Model="_profile">
        <DataAnnotationsValidator/>
        <ValidationSummary/>

        <div class="row">
            <!-- Vertical nav -->
            <div class="col-md-3 col-lg-2 mb-3 mb-md-0">
                <div class="nav flex-column nav-pills mux-tab-row" role="tablist">
                    <button type="button"
                            class="nav-link text-start @(_tab == "general" ? "active" : "")"
                            @onclick='() => _tab = "general"'>
                        <i class="bi bi-gear me-2"></i>General
                    </button>
                    <button type="button"
                            class="nav-link text-start @(_tab == "video" ? "active" : "")"
                            @onclick='() => _tab = "video"'>
                        <i class="bi bi-film me-2"></i>Video
                    </button>
                    <button type="button"
                            class="nav-link text-start @(_tab == "audio" ? "active" : "")"
                            @onclick='() => _tab = "audio"'>
                        <i class="bi bi-volume-up me-2"></i>Audio
                    </button>
                    <button type="button"
                            class="nav-link text-start @(_tab == "subtitles" ? "active" : "")"
                            @onclick='() => _tab = "subtitles"'>
                        <i class="bi bi-chat-text me-2"></i>Subtitles
                    </button>
                </div>
            </div>

            <!-- Tab content -->
            <div class="col-md-9 col-lg-10">
                <div class="border rounded p-4">
                    @if (_tab == "general")
                    {
                        <h5 class="mb-3"><i class="bi bi-gear text-primary me-2"></i>General</h5>
                        <div class="mb-3">
                            <label for="profile-name" class="form-label">Profile Name</label>
                            <InputText id="profile-name" class="form-control" @bind-Value="_profile.Name"/>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Monitored Directories</label>
                            <DirectoryEditor @bind-Directories="_profile.Directories"/>
                            <small class="form-text text-muted">Directories to scan for media files using this
                                profile.</small>
                        </div>
                        <div class="mb-3 form-check form-switch">
                            <InputCheckbox id="skipHardlinked" class="form-check-input"
                                           @bind-Value="_profile.SkipHardlinkedFiles"/>
                            <label class="form-check-label" for="skipHardlinked">Skip hardlinked files</label>
                            <small class="form-text text-muted d-block">Do not scan or process files that have more than
                                one hard link.</small>
                        </div>
                        <div class="mb-3 form-check form-switch">
                            <InputCheckbox id="clearFileTitle" class="form-check-input"
                                           @bind-Value="_profile.ClearFileTitle"/>
                            <label class="form-check-label" for="clearFileTitle">Clear file title</label>
                            <small class="form-text text-muted d-block">Remove the file title (often a release-group
                                name
                                or other leftover text shown as the file's "Title") during conversion.</small>
                        </div>
                        <div class="mb-3 form-check form-switch">
                            <InputCheckbox id="removeChapters" class="form-check-input"
                                           @bind-Value="_profile.RemoveChapters"/>
                            <label class="form-check-label" for="removeChapters">Remove chapters</label>
                            <small class="form-text text-muted d-block">Remove chapter markers from the file during
                                conversion.</small>
                        </div>
                        <div class="mb-3 form-check form-switch">
                            <InputCheckbox id="backupTrackNames" class="form-check-input"
                                           @bind-Value="_profile.BackupTrackNames"/>
                            <label class="form-check-label" for="backupTrackNames">Back up original track names</label>
                            <small class="form-text text-muted d-block">Keep the names each file's tracks arrived with,
                                in a hidden <code>.muxarr-tracks.json</code> in its folder and in the database. They show
                                on the file's page and in custom conversions, and <code>{originalname}</code> writes them
                                in a template. Files muxarr already converted get the names from before their first
                                conversion. Takes effect on the next scan.</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="extrasStrategy">Extras folders</label>
                            <InputSelect id="extrasStrategy" class="form-select" @bind-Value="_profile.Extras">
                                <option value="@ExtrasStrategy.Process">Same rules as the main files</option>
                                <option value="@ExtrasStrategy.KeepAllTracks">Keep every track, only tidy names and flags</option>
                                <option value="@ExtrasStrategy.Skip">Skip them</option>
                            </InputSelect>
                            <small class="form-text text-muted d-block">Files in Jellyfin extras folders
                                (<code>Featurettes</code>, <code>Behind The Scenes</code>, <code>Deleted Scenes</code>,
                                <code>Interviews</code>, <code>Scenes</code>, <code>Shorts</code>, <code>Clips</code>,
                                <code>Extras</code>). Extras often carry a single track in an unexpected language, so the
                                language rules can strip them bare. Trailers and samples are always skipped.</small>
                        </div>
                        if (_otherProfiles.Count > 0)
                        {
                            <div class="mb-3">
                                <label class="form-label" for="copyCodecNamesFrom">Copy codec names from another
                                    profile</label>
                                <div class="d-flex gap-2">
                                    <select id="copyCodecNamesFrom" class="form-select" style="width: auto;"
                                            @bind="_copyFromProfileId">
                                        @foreach (var other in _otherProfiles)
                                        {
                                            <option value="@other.Id">@other.Name</option>
                                        }
                                    </select>
                                    <button type="button" class="btn btn-outline-secondary" @onclick="CopyCodecNames">
                                        <i class="bi bi-files me-2"></i>Copy
                                    </button>
                                </div>
                                <small class="form-text text-muted d-block">Replaces this profile's audio, subtitle and
                                    video codec names and its Dolby Vision wording. Nothing is saved until you
                                    save.</small>
                            </div>
                        }
                    }
                    else if (_tab == "video")
                    {
                        <h5 class="mb-3"><i class="bi bi-film text-primary me-2"></i>Video Settings</h5>
                        <div class="mb-3 form-check form-switch">
                            <InputCheckbox id="clearVideoNames" class="form-check-input"
                                           @bind-Value="_profile.ClearVideoTrackNames"/>
                            <label class="form-check-label" for="clearVideoNames">Clear video track names</label>
                            <small class="form-text text-muted d-block">Remove release-group branding and other leftover
                                text from video track names during conversion.</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="videoLanguage">Video track language</label>
                            <InputSelect id="videoLanguage" class="form-select"
                                         @bind-Value="_profile.VideoSettings.VideoLanguage">
                                <option value="@VideoLanguageMode.Leave">Leave as is</option>
                                <option value="@VideoLanguageMode.OriginalLanguage">Original language (from
                                    Radarr/Sonarr)</option>
                                <option value="@VideoLanguageMode.Undetermined">Undetermined (und)</option>
                            </InputSelect>
                            <small class="form-text text-muted d-block">Players don't use it; it's for tidy media
                                info. Original language follows what Blu-ray discs do, and files without a known
                                original language are left alone. Changes are a quick in-place edit, not a
                                remux.</small>
                        </div>
                        <div class="mb-3 form-check form-switch">
                            <InputCheckbox id="standardizeVideoNames" class="form-check-input"
                                           @bind-Value="_profile.VideoSettings.StandardizeTrackNames"
                                           @bind-Value:after="OnStandardizeVideoToggled"/>
                            <label class="form-check-label" for="standardizeVideoNames">Standardize video track
                                names</label>
                            <small class="form-text text-muted d-block">Rename video tracks using a template, for
                                example with the Dolby Vision profile. Wins over clearing the name.</small>
                        </div>
                        @if (_profile.VideoSettings.StandardizeTrackNames)
                        {
                            <div class="mb-3 ms-4">
                                <div class="option-label text-muted small mb-1">Template</div>
                                <InputText id="videoTrackNameTemplate" class="form-control form-control-sm"
                                           @bind-Value="_profile.VideoSettings.TrackNameTemplate"/>
                                <small class="form-text text-muted d-block">
                                    Placeholders: <code>{codec}</code>, <code>{resolution}</code> (2160p, 1080p),
                                    <code>{hdr}</code> (HDR10, HDR10+, HLG),
                                    <code>{range}</code> (like <code>{hdr}</code>, plus SDR for video with no HDR or
                                    Dolby Vision),
                                    <code>{dv}</code> (Dolby Vision Profile 7 FEL), <code>{dvprofile}</code> (7, 8.1),
                                    <code>{dvlayer}</code> (FEL, MEL), <code>{trackname}</code>.
                                    FEL/MEL needs dovi_tool, which the image includes. Leave empty to clear video track
                                    names.
                                </small>
                                <div class="mt-2 option-label text-muted small mb-1">Dolby Vision wording</div>
                                <InputText id="videoDolbyVisionTemplate" class="form-control form-control-sm"
                                           placeholder="@HdrInfo.DefaultDolbyVisionTemplate"
                                           @bind-Value="_profile.VideoSettings.DolbyVisionTemplate"/>
                                <small class="form-text text-muted d-block">
                                    What <code>{dv}</code> writes, with <code>{dvprofile}</code> and
                                    <code>{dvlayer}</code>. Empty uses
                                    <code>@HdrInfo.DefaultDolbyVisionTemplate</code>; <code>DV P{dvprofile} {dvlayer}</code>
                                    gives "DV P7 FEL". Rename HDR10, HDR10+, HLG, FEL and MEL in the list below.
                                </small>
                                <div class="mt-2 text-muted small">
                                    <i class="bi bi-eye me-1"></i>Preview:
                                    <div class="mt-1">
                                        @foreach (var track in VideoPreviewTracks)
                                        {
                                            <div>
                                                <code>@(track.ApplyTrackNameTemplate(_profile.VideoSettings.TrackNameTemplate, _profile.VideoSettings.CodecNames, _profile.VideoSettings.DolbyVisionTemplate) ?? "(empty)")</code>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="mt-3 option-label text-muted small mb-1">Codec and HDR names</div>
                                <div class="d-flex flex-column gap-2 ms-2 border-start ps-3">
                                    @foreach (var label in CodecNames.Labels(MediaTrackType.Video))
                                    {
                                        var currentLabel = label;
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge text-bg-secondary text-truncate" style="width: 170px;"
                                                  title="@label">@label</span>
                                            <input type="text" class="form-control form-control-sm"
                                                   style="max-width: 300px;" placeholder="@label"
                                                   value="@(_profile.VideoSettings.CodecNames.GetValueOrDefault(currentLabel) ?? "")"
                                                   @onchange="e => SetVideoCodecName(currentLabel, e.Value?.ToString())"/>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        <div class="mb-3 form-check form-switch">
                            <InputCheckbox id="trimToVideoLength" class="form-check-input"
                                           @bind-Value="_profile.TrimToVideoLength"/>
                            <label class="form-check-label" for="trimToVideoLength">Trim all tracks to video
                                length</label>
                            <ToolTip
                                Tip="Cuts real audio and subtitle content. Only use it on files whose tracks are wrong.">
                                <i class="bi bi-exclamation-triangle-fill text-warning ms-1"></i>
                            </ToolTip>
                            <small class="form-text text-muted d-block">Discard audio and subtitle content that runs
                                past the end of the video track. Only enable this when you have files with incorrect
                                audio or subtitle tracks that make the file look longer than it really is and cause
                                issues. Applied only when the file is already being converted for other reasons, so
                                it never queues a conversion by itself.</small>
                        </div>
                    }
                    else if (_tab == "audio")
                    {
                        <h5 class="mb-3"><i class="bi bi-volume-up text-primary me-2"></i>Audio Settings</h5>
                        <TrackSettingsEditor Settings="_profile.AudioSettings" TrackType="MediaTrackType.Audio"/>
                    }
                    else if (_tab == "subtitles")
                    {
                        <h5 class="mb-3"><i class="bi bi-chat-text text-primary me-2"></i>Subtitle Settings</h5>
                        <TrackSettingsEditor Settings="_profile.SubtitleSettings" TrackType="MediaTrackType.Subtitles"/>
                    }
                </div>
            </div>
        </div>

        <StickyBar>
            <button type="button" class="btn btn-primary" @onclick="Save" disabled="@_saving">
                <i class="bi bi-save me-2"></i>Save Settings
            </button>
            <button type="button" class="btn btn-outline-secondary ms-auto" @onclick="SaveAndScan" disabled="@_saving">
                <i class="bi bi-arrow-repeat me-2"></i>Save Settings & Scan
            </button>
        </StickyBar>
    </EditForm>
</div>

@code {
    [Inject] public required IDbContextFactory<AppDbContext> ContextFactory { get; set; }
    [Inject] public required NavigationManager NavigationManager { get; set; }
    [Inject] public required IToastService ToastService { get; set; }
    [Inject] public required IModalService ModalService { get; set; }
    [Inject] public required MediaScannerService MediaScanner { get; set; }

    [Parameter] public int Id { get; set; }

    private Profile? _profile;
    private string _tab = "general";
    private bool _saving;
    private bool IsNew => Id == 0;
    private List<Profile> _otherProfiles = [];
    private int _copyFromProfileId;

    protected override async Task OnInitializedAsync()
    {
        await using (var profiles = await ContextFactory.CreateDbContextAsync())
        {
            _otherProfiles = await profiles.Profiles.AsNoTracking()
                .Where(p => p.Id != Id)
                .OrderBy(p => p.Name)
                .ToListAsync();
            _copyFromProfileId = _otherProfiles.FirstOrDefault()?.Id ?? 0;
        }

        if (IsNew)
        {
            _profile = new Profile
            {
                Name = "New Profile",
                AudioSettings = { AssumeUndeterminedIsOriginal = true }
            };
            return;
        }

        await using var context = await ContextFactory.CreateDbContextAsync();
        var original = await context.Profiles.FirstOrDefaultAsync(p => p.Id == Id);
        _profile = original?.Clone();
    }

    private async Task Save()
    {
        await SaveProfile(false);
    }

    private async Task SaveAndScan()
    {
        await SaveProfile(true);
    }

    private async Task SaveProfile(bool scan)
    {
        if (_profile == null || _saving)
        {
            return;
        }

        _saving = true;

        try
        {
            _profile.Directories = _profile.Directories.Where(x => !string.IsNullOrEmpty(x)).ToList();

            await using var context = await ContextFactory.CreateDbContextAsync();

            if (IsNew)
            {
                context.Add(_profile);
            }
            else
            {
                var existing = await context.Profiles.FirstAsync(x => x.Id == _profile.Id);
                existing.Name = _profile.Name;
                existing.Directories = _profile.Directories;
                existing.ClearVideoTrackNames = _profile.ClearVideoTrackNames;
                existing.ClearFileTitle = _profile.ClearFileTitle;
                existing.RemoveChapters = _profile.RemoveChapters;
                existing.TrimToVideoLength = _profile.TrimToVideoLength;
                existing.SkipHardlinkedFiles = _profile.SkipHardlinkedFiles;
                existing.BackupTrackNames = _profile.BackupTrackNames;
                existing.Extras = _profile.Extras;
                existing.AudioSettings = _profile.AudioSettings;
                existing.SubtitleSettings = _profile.SubtitleSettings;
                existing.VideoSettings = _profile.VideoSettings;
                context.Update(existing);
            }

            await context.SaveChangesAsync();
            ToastService.ShowSuccess($"Profile '{_profile.Name}' saved successfully.");
        }
        finally
        {
            _saving = false;
        }

        if (scan)
        {
            _ = MediaScanner.ScanAll(false);
            ToastService.ShowInfo("Library scan started.");
            NavigationManager.NavigateTo("/settings");
        }
        else if (IsNew)
        {
            NavigationManager.NavigateTo($"/settings/profile/{_profile.Id}", replace: true);
        }
    }


    private static readonly List<TrackSnapshot> VideoPreviewTracks =
    [
        new() { Type = MediaTrackType.Video, Codec = nameof(VideoCodec.Hevc), HdrFormat = HdrInfo.Hdr10, DvProfile = "7", DvLayer = HdrInfo.Fel, Resolution = "3840x2160" },
        new() { Type = MediaTrackType.Video, Codec = nameof(VideoCodec.Hevc), HdrFormat = HdrInfo.Hdr10, DvProfile = "8.1", Resolution = "3840x1600" },
        new() { Type = MediaTrackType.Video, Codec = nameof(VideoCodec.Hevc), HdrFormat = HdrInfo.Hdr10 },
        new() { Type = MediaTrackType.Video, Codec = nameof(VideoCodec.Avc), Resolution = "1920x1080" }
    ];

    private void CopyCodecNames()
    {
        var source = _otherProfiles.FirstOrDefault(p => p.Id == _copyFromProfileId);
        if (_profile == null || source == null)
        {
            return;
        }

        _profile.AudioSettings.CodecNames = new Dictionary<string, string>(source.AudioSettings.CodecNames);
        _profile.SubtitleSettings.CodecNames = new Dictionary<string, string>(source.SubtitleSettings.CodecNames);
        _profile.VideoSettings.CodecNames = new Dictionary<string, string>(source.VideoSettings.CodecNames);
        _profile.VideoSettings.DolbyVisionTemplate = source.VideoSettings.DolbyVisionTemplate;
        ToastService.ShowInfo($"Codec names copied from '{source.Name}'. Save to keep them.");
    }

    private void OnStandardizeVideoToggled()
    {
        if (_profile is { VideoSettings: { StandardizeTrackNames: true, TrackNameTemplate: "" } })
        {
            _profile.VideoSettings.TrackNameTemplate = "{codec} {dv} {hdr}";
        }
    }

    private void SetVideoCodecName(string label, string? value)
    {
        if (_profile == null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(value))
        {
            _profile.VideoSettings.CodecNames.Remove(label);
        }
        else
        {
            _profile.VideoSettings.CodecNames[label] = value.Trim();
        }
    }

}
