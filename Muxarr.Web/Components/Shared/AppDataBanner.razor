@using Muxarr.Data

@if (ContainerAppData.State == AppDataState.LegacyLocation)
{
    <div class="alert alert-warning py-2 small mb-3" role="alert">
        <i class="bi bi-info-circle me-1"></i>
        Remuxarr moved its appdata to <code>/config</code>, the same layout as the linuxserver containers. This install still runs from <code>/data</code>, which keeps working; when you have a minute, mount your appdata folder at <code>:/config</code> instead of <code>:/data</code> and restart.
    </div>
}
